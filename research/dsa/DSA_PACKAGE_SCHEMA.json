    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "DSA_PACKAGE_SCHEMA.json"
        },
        "dataset_type": {
          "const": "dsa"
        },
        "research_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
