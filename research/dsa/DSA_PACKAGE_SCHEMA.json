        "tracks": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]{2,149}$",
                "title": "Id",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "title": "Entity",
            "type": "object"
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]{2,149}$",
                "title": "Id",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "title": "Entity",
            "type": "object"
          }
        },
        "modules": {
          "type": "array",
          "maxItems": 10000,
