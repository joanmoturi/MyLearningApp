        "resources": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]{2,149}$",
                "title": "Id",
                "type": "string"
              },
