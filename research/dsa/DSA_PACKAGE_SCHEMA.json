              "hints",
              "solution_code",
              "detailed_explanation",
              "complexity",
              "expected_answer_elements",
              "evaluation_rubric",
              "follow_up_questions",
              "common_mistakes",
              "related_question_ids",
              "source_ids",
              "recommended_minutes",
              "authorship"
